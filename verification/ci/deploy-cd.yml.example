# Fly deployment of the public playground (app "varde") from CI — commissioned
# by the PO on 2026-08-22 ("deploy from CI"), replacing orchestrator-local flyctl.
#
# Security posture (the same regime as the harness-review lanes):
#   1. Full commit-SHA pin: superfly/flyctl-actions/setup-flyctl is pinned to
#      ed8efb33836e8b2096c7fd3ba1c8afe303ebbff1 (= tag 1.6) — tags are mutable.
#   2. Secret-gated: without FLY_API_TOKEN the job skips green with ::notice —
#      forks/CI without deployment permission never fail red because of this.
#      The token must be an APP-SCOPED deployment token (flyctl tokens create
#      deploy -a varde), never an organization token.
#   3. Permissions: contents:read — nothing else.
#   4. Concurrency: one deployment at a time, latest wins (the playground is one
#      machine with an ephemeral DB; parallel deployments only add noise).
#   5. Triggers: push to main (main receives ONLY locally verified trains,
#      OPERATIONS §5 — CI here is deployment, not a gate) + workflow_dispatch
#      for a manual redeployment from the GitHub UI.
#   6. --remote-only: the build runs on Fly's builders; no Docker in the runner
#      and no registry secrets in CI.

name: fly-deploy

on:
  push:
    branches: [main]
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: fly-deploy-varde
  cancel-in-progress: true

jobs:
  deploy:
    runs-on: ubuntu-latest
    steps:
      - name: Check deployment token
        id: gate
        env:
          FLY_API_TOKEN: ${{ secrets.FLY_API_TOKEN }}
        run: |
          if [ -z "$FLY_API_TOKEN" ]; then
            echo "::notice::FLY_API_TOKEN is not set — deployment skipped (green)."
            echo "enabled=false" >> "$GITHUB_OUTPUT"
          else
            echo "enabled=true" >> "$GITHUB_OUTPUT"
          fi
      - name: Checkout
        if: steps.gate.outputs.enabled == 'true'
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      - name: Set up flyctl
        if: steps.gate.outputs.enabled == 'true'
        uses: superfly/flyctl-actions/setup-flyctl@ed8efb33836e8b2096c7fd3ba1c8afe303ebbff1 # 1.6
      - name: Deploy
        if: steps.gate.outputs.enabled == 'true'
        env:
          FLY_API_TOKEN: ${{ secrets.FLY_API_TOKEN }}
        run: flyctl deploy --remote-only -a varde
