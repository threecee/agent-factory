# Fly-deploy av den offentlige playgrounden (app "varde") fra CI — PO-bestilt
# 2026-08-22 («deploy fra CI»), erstatter orkestrator-lokal flyctl.
#
# Sikkerhetsposisjon (samme regime som harness-review-lanene):
#   1. Full commit-SHA-pin: superfly/flyctl-actions/setup-flyctl pinnes til
#      ed8efb33836e8b2096c7fd3ba1c8afe303ebbff1 (= tag 1.6) — tags er mutable.
#   2. Secret-gated: uten FLY_API_TOKEN hopper jobben grønt med ::notice —
#      forken/CI uten deploy-rett feiler aldri rødt på dette.
#      Tokenet skal være et APP-SCOPET deploy-token (flyctl tokens create
#      deploy -a varde), aldri et org-token.
#   3. Permissions: contents:read — ingenting annet.
#   4. Concurrency: én deploy om gangen, siste vinner (playgrounden er én
#      maskin med ephemeral DB; parallelle deploys gir bare støy).
#   5. Triggers: push til main (main mottar KUN lokalt verifiserte tog,
#      OPERATIONS §5 — CI her er utrulling, ikke port) + workflow_dispatch
#      for manuell omdeploy fra GitHub-UI.
#   6. --remote-only: bygget skjer på Flys byggere; ingen Docker i runneren,
#      ingen registry-secrets i CI.

name: fly-deploy

on:
  push:
    branches: [main]
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: fly-deploy-varde
  cancel-in-progress: true

jobs:
  deploy:
    runs-on: ubuntu-latest
    steps:
      - name: Sjekk deploy-token
        id: gate
        env:
          FLY_API_TOKEN: ${{ secrets.FLY_API_TOKEN }}
        run: |
          if [ -z "$FLY_API_TOKEN" ]; then
            echo "::notice::FLY_API_TOKEN er ikke satt — deploy hoppes over (grønt)."
            echo "enabled=false" >> "$GITHUB_OUTPUT"
          else
            echo "enabled=true" >> "$GITHUB_OUTPUT"
          fi
      - name: Checkout
        if: steps.gate.outputs.enabled == 'true'
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      - name: Sett opp flyctl
        if: steps.gate.outputs.enabled == 'true'
        uses: superfly/flyctl-actions/setup-flyctl@ed8efb33836e8b2096c7fd3ba1c8afe303ebbff1 # 1.6
      - name: Deploy
        if: steps.gate.outputs.enabled == 'true'
        env:
          FLY_API_TOKEN: ${{ secrets.FLY_API_TOKEN }}
        run: flyctl deploy --remote-only -a varde
